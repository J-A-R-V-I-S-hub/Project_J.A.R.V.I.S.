TELEGRAM_BOT_TOKEN=__INSERT_TELEGRAM_BOT_TOKEN__
TELEGRAM_ALLOWED_USER_ID=__INSERT_TELEGRAM_USER_ID__

OPENROUTER_API_KEY=__INSERT_OPENROUTER_API_KEY__
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
OPENROUTER_AUDIO_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_MEMORY_MODEL=openai/gpt-4.1-nano

AGNO_DB_PATH=data/jarvis.db
JARVIS_WORKSPACE_DIR=data/workspace
JARVIS_INCOMING_DIR=data/incoming
JARVIS_OUTPUT_DIR=data/output
JARVIS_REPORTS_DIR=data/reports
JARVIS_PYTHON_SANDBOX_DIR=data/sandbox/python
JARVIS_SHELL_SANDBOX_DIR=data/sandbox/shell

JARVIS_TIMEZONE=Europe/Rome
JARVIS_HISTORY_RUNS=8
JARVIS_TOOL_CALL_LIMIT=10
JARVIS_AGENT_RETRIES=1
JARVIS_MAX_CONCURRENT_RUNS=1

JARVIS_APP_DB_PATH=data/jarvis_app.db
JARVIS_REMINDER_POLL_SECONDS=15
JARVIS_DAILY_BRIEF_ENABLED=true
JARVIS_DAILY_BRIEF_TIME=08:00
JARVIS_LOCATION=Milano, Italy
# Opzionali: se impostati evitano la geocodifica del nome
# JARVIS_LATITUDE=45.0
# JARVIS_LONGITUDE=9.1
JARVIS_FILE_RETENTION_DAYS=30
JARVIS_QUALITY_WATCH_DIR=data/quality
JARVIS_QUALITY_WATCH_ENABLED=true

# Media opzionali (TTS + generazione immagini). Senza chiave, il TTS usa macOS 'say'.
OPENAI_API_KEY=
JARVIS_TTS_MODEL=gpt-4o-mini-tts
JARVIS_TTS_VOICE=alloy
JARVIS_IMAGE_MODEL=gpt-image-1
JARVIS_VOICE_MAX_CHARS=1500

# Knowledge base locale (SQLite FTS5)
JARVIS_KNOWLEDGE_DB_PATH=data/knowledge.db
JARVIS_KNOWLEDGE_DIR=data/knowledge
JARVIS_KNOWLEDGE_ENABLED=true
JARVIS_KNOWLEDGE_CHUNK_CHARS=1200
JARVIS_KNOWLEDGE_MAX_RESULTS=5

# Integrazioni opzionali (attive solo se compilate)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
NOTION_TOKEN=
NOTION_DATABASE_ID=
CALENDAR_ICS_URL=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
LOG_LEVEL=INFO
